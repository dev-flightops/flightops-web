# Copy to .env.local and fill in. Three modes for backend connection:

# --- Mode A: pointing at Marc's local Docker via LAN IP (same network) ---
# NEXT_PUBLIC_API_URL=http://192.168.1.42:8000

# --- Mode B: pointing at Marc's Cloudflare tunnel (remote collaboration) ---
# NEXT_PUBLIC_API_URL=https://shy-mountain-xxxx.trycloudflare.com

# --- Mode C: pointing at local Docker (Marc + Greg on same machine) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Mode D: pointing at Render staging (independent work, always-on) ---
# NEXT_PUBLIC_API_URL=https://flightops-gateway-staging.onrender.com

# Auth.js v5 — signs the session JWT. Generate: openssl rand -hex 32
AUTH_SECRET=replace-me-with-openssl-rand-hex-32

# SSO only: the same secret as auth-service's AUTH_EXCHANGE_SECRET (32+
# characters). Without it SSO sign-in is off. Server-only; never expose it.
# AUTH_EXCHANGE_SECRET=

# SSO providers: the same names auth-service reads to list them. A provider
# is on only with every line it needs (lib/sso-providers.ts).
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_CLIENT_ID=
# AUTH_MICROSOFT_ENTRA_ID_CLIENT_SECRET=
# Pinned to the client's tenant; /common/ would admit every Entra tenant.
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# AUTH_OKTA_CLIENT_ID=
# AUTH_OKTA_CLIENT_SECRET=
# AUTH_OKTA_ISSUER=https://<org>.okta.com

# Optional: only needed if behind a reverse proxy that strips host header
# AUTH_URL=http://localhost:3000
